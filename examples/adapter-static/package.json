    "@unhead/vue": "^1.9.16",
    "hono": "^4.2.3",
    "vue": "^3",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@biliblitz/adapter-static": "workspace:^",
    "@biliblitz/vite": "workspace:^",
    "@types/node": "^22.0.0",
    "@unhead/addons": "^1.9.16",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}

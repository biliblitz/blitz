{
  "name": "@example/adapter-nodejs",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vue-tsc --build && pnpm run build:client && pnpm run build:nodejs",
    "build:client": "vite build --manifest",
    "build:nodejs": "vite build --ssr -c adapters/nodejs/vite.config.ts",
    "start": "node server.js",
    "dev": "vite"
  },
  "license": "MIT",
  "dependencies": {
    "@biliblitz/blitz": "workspace:^",
    "@hono/node-server": "^1.10.1",
    "@unhead/ssr": "^1.9.16",
    "@unhead/vue": "^1.9.16",
    "hono": "^4.2.3",
    "vue": "^3",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@biliblitz/adapter-nodejs": "workspace:^",
    "@biliblitz/vite": "workspace:^",
    "@types/node": "^22.0.0",
    "@unhead/addons": "^1.9.16",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-tsc": "^3.3.13"
  }
}
